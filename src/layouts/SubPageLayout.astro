---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Text for the back link in the top bar. */
  backLabel?: string;
  backHref?: string;
}
const {
  title,
  description,
  image,
  backLabel = site.name,
  backHref = '/',
} = Astro.props;
---
<BaseLayout title={title} description={description} image={image}>
  <div class="subpage">
    <div class="subpage__bar no-print">
      <a class="backlink" href={backHref}>
        <Icon name="arrow-left" size={16} />
        {backLabel}
      </a>
      <ThemeToggle />
    </div>
    <main id="main" class="subpage__main">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .subpage {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-5) var(--space-8);
  }
  .subpage__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0 var(--space-6);
  }
  .subpage__main {
    scroll-margin-top: var(--space-5);
  }
</style>
