---
import { render } from 'astro:content';
import SubPageLayout from '../../layouts/SubPageLayout.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import Icon from '../../components/Icon.astro';
import { getProjectsWithBody, isRealUrl, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjectsWithBody();
  return projects.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

interface Props {
  entry: Project;
}
const { entry } = Astro.props;
const { title, years, org, role, summary, links, video, in_my_words } = entry.data;
const { Content } = await render(entry);

const linkTypeToIcon: Record<string, string> = {
  demo: 'external',
  source: 'github',
  video: 'video',
  report: 'report',
  site: 'site',
  article: 'article',
  book: 'book',
  map: 'map',
};
---
<SubPageLayout title={title} description={summary} backLabel="Back to projects" backHref="/#projects">
  <article class="project">
    <p class="project__meta">{years} · {org} · {role}</p>
    <h1 class="project__title">{title}</h1>
    <p class="project__summary">{summary}</p>

    {
      links.length > 0 && (
        <ul class="project__links">
          {links.map((l) =>
            isRealUrl(l.url) ? (
              <li>
                <a class="text-link" href={l.url} target="_blank" rel="noopener">
                  <Icon name={linkTypeToIcon[l.type ?? 'site'] ?? 'external'} size={15} />
                  {l.label}
                </a>
              </li>
            ) : (
              <li>
                <span class="project__link-pending" title="Link coming soon">
                  <Icon name={linkTypeToIcon[l.type ?? 'site'] ?? 'external'} size={15} />
                  {l.label}
                </span>
              </li>
            )
          )}
        </ul>
      )
    }

    {video && (
      <div class="project__video">
        <YouTubeFacade youtubeId={video.youtubeId} caption={video.caption} />
      </div>
    )}

    {
      in_my_words && (
        <aside class="project__note">
          <span class="project__note-label">In my words</span>
          <p>{in_my_words}</p>
        </aside>
      )
    }

    <div class="project__body prose">
      <Content />
    </div>
  </article>
</SubPageLayout>

<style>
  .project__meta {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .project__title {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .project__summary {
    font-size: var(--text-lg);
    color: var(--muted);
    line-height: 1.6;
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }
  .project__link-pending {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--muted);
    font-style: italic;
  }
  .project__video {
    margin-top: var(--space-6);
  }
  .project__note {
    margin-top: var(--space-6);
    padding: var(--space-4);
    border-left: 2px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .project__note-label {
    display: block;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .project__body {
    margin-top: var(--space-6);
  }
  .project__body :global(h2) {
    font-size: var(--text-xl);
    margin: var(--space-6) 0 var(--space-3);
  }
  .project__body :global(h3) {
    font-size: var(--text-lg);
    margin: var(--space-5) 0 var(--space-2);
  }
  .project__body :global(p) {
    margin-bottom: var(--space-4);
  }
  .project__body :global(ul),
  .project__body :global(ol) {
    margin: 0 0 var(--space-4) var(--space-5);
  }
</style>
