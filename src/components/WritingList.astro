---
import type { WritingGroup } from '../lib/content';
import { isRealUrl } from '../lib/content';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  groups: WritingGroup[];
}
const { groups } = Astro.props;

// Thumbnails live in src/assets/writing/ and are named in writing.json.
const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/writing/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const thumbFor = (name?: string) => (name ? thumbs[`../assets/writing/${name}`]?.default : undefined);
---
<div class="writing">
  {
    groups
      .filter((g) => g.items.length > 0 || g.description)
      .map((group) => (
        <section class="writing__group">
          <h3 class="writing__group-title">{group.label}</h3>
          {group.description && <p class="writing__group-desc">{group.description}</p>}
          <ul class="writing__list">
            {group.items.map((item) => {
              const thumb = thumbFor(item.data.thumbnail);
              return (
              <li class:list={['writing__item', { 'writing__item--thumb': thumb }]}>
                <span class="writing__date">{item.data.date}</span>
                <span class="writing__title">
                  {isRealUrl(item.data.url) ? (
                    <a class="text-link" href={item.data.url} target="_blank" rel="noopener">
                      {item.data.title}
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  ) : (
                    item.data.title
                  )}
                  {item.data.note && <span class="writing__note"> — {item.data.note}</span>}
                </span>
                {thumb && (
                  <Image
                    class="writing__thumb"
                    src={thumb}
                    alt={item.data.thumbnailAlt ?? ''}
                    height={240}
                    densities={[1, 2]}
                    loading="lazy"
                  />
                )}
              </li>
              );
            })}
          </ul>
        </section>
      ))
  }
</div>

<style>
  .writing__group + .writing__group {
    margin-top: var(--space-6);
  }
  .writing__group-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .writing__group-desc {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-3);
    max-width: 60ch;
  }
  .writing__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .writing__item {
    display: grid;
    gap: 0.1rem var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border);
  }
  .writing__item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .writing__date {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding-top: 0.15rem;
  }
  .writing__title {
    font-size: var(--text-sm);
    color: var(--text);
  }
  /* Keep the small arrow right after the last word when a title wraps. */
  .writing__title .text-link {
    display: inline;
  }
  .writing__title .text-link :global(svg) {
    display: inline-block;
    vertical-align: -2px;
    margin-left: 0.2rem;
  }
  .writing__note {
    color: var(--muted);
  }

  /* Medium thumbnails beside "Earlier writing" entries. Every thumbnail has the
     same height; width follows the image's shape (the GJIA collage is widest). */
  .writing__thumb {
    height: 120px;
    width: auto;
    max-width: 100%;
    border-radius: 4px;
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .writing__item {
      grid-template-columns: 8rem 1fr;
    }
    .writing__item--thumb {
      /* A fixed thumbnail column keeps the titles the same width on every row. */
      grid-template-columns: 8rem 1fr 260px;
      align-items: center;
    }
    .writing__item--thumb .writing__date {
      align-self: center;
      padding-top: 0;
    }
    .writing__thumb {
      margin-top: 0;
      max-width: 260px;
      object-fit: contain;
    }
  }

  /* Phones: the thumbnail sits under the title. */
  @media (max-width: 639px) {
    .writing__thumb {
      grid-column: 1 / -1;
    }
  }
</style>
